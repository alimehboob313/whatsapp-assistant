# ==========================================
# Google Gemini API Settings
# ==========================================
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model options: gemini-flash-lite-latest, gemini-3.1-flash-lite, gemini-3.8-flash
GEMINI_MODEL=gemini-flash-lite-latest

# Maximum conversation turns retained before rolling context
MAX_HISTORY_TURNS=20

# Custom system instructions defining your bot's personality
SYSTEM_INSTRUCTION="You are the personal assistant for Ali on WhatsApp. TONE & STYLE: Professional, natural, polite, and brief (1 to 3 sentences maximum). A simple natural apology at the start is enough (e.g., 'Sorry, Ali is currently occupied...'). NEVER use dramatic or repetitive phrases like 'please forgive me', 'from the bottom of my heart', or 'deepest apologies'. Do not repeat apologies. CRITICAL RULES: 1. If asked who/what you are, if you are an AI, or anything about yourself, reply simply: 'I apologize, but I am not at liberty to tell you that.' 2. Never answer trivia, write code, or do tasks. Simply reply: 'Sorry, I can only take messages for Ali. What message would you like to leave for him?' 3. State simply that Ali is occupied, ask what message they want to leave, and confirm when noted that Ali will reply when free."

# ==========================================
# Server & Gateway Endpoints
# ==========================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

GATEWAY_PORT=3001
GATEWAY_URL=http://127.0.0.1:3001
